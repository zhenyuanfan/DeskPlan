<Window x:Class="DeskPlan.OverdueReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="整理未完成工作" Width="640" Height="460" MinWidth="620" MinHeight="360" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="整理未完成工作" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
        <TextBlock Grid.Row="1" Text="选择一项：移到今天、保留在原日期，或标记为跳过。" TextWrapping="Wrap" Margin="0,6,0,18" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="8">
            <Grid>
                <ListBox x:Name="TaskList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,10">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="0,0,12,0" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding RepeatText}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding DisplayDate, StringFormat={}{0:yyyy / MM / dd}}" FontSize="11" Margin="0,5,0,0" Foreground="{DynamicResource MutedTextBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=TaskList}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="都整理好了" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="安心回到今天的安排" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Button Content="全部移到今天" Click="MoveAll_Click" HorizontalAlignment="Left" Padding="10,8" FontSize="12" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="移到今天" Click="MoveToday_Click" Margin="0,0,6,0" Padding="10,8" FontSize="12" />
                <Button Content="保留原日" Click="Keep_Click" Margin="0,0,6,0" Padding="10,8" FontSize="12" />
                <Button Content="跳过" Click="Skip_Click" Margin="0,0,6,0" Padding="10,8" FontSize="12" />
                <Button Content="完成" Click="Close_Click" Background="{DynamicResource AccentBrush}" Foreground="White" BorderBrush="{DynamicResource AccentBrush}" Padding="16,8" FontSize="12" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
