<Window x:Class="DeskPlan.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面计划设置" Width="430" Height="280" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Microsoft YaHei UI">
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
        <CheckBox x:Name="AutoStartCheck" Grid.Row="1" Content="Windows 登录后自动启动"
                  Margin="0,26,0,0" Foreground="{DynamicResource TextBrush}" />
        <StackPanel Grid.Row="2" Margin="0,24,0,0">
            <TextBlock Text="所有任务和备份都只保存在本机。" Foreground="{DynamicResource MutedTextBrush}" />
            <Button Content="打开数据目录" Click="OpenData_Click" HorizontalAlignment="Left" Margin="0,10,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Click="Cancel_Click" Margin="0,0,8,0" />
            <Button Content="保存" Click="Save_Click" Width="86" Background="{DynamicResource AccentBrush}"
                    Foreground="White" BorderBrush="{DynamicResource AccentBrush}" />
        </StackPanel>
    </Grid>
</Window>
