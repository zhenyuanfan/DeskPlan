<Window x:Class="DeskPlan.TaskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="任务详情" Width="480" Height="650" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Microsoft YaHei UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="任务名称" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6" />
            <TextBox x:Name="TitleBox" FontSize="17" />
        </StackPanel>

        <TextBlock x:Name="OccurrenceHint" Grid.Row="1" Visibility="Collapsed" Margin="0,12,0,0"
                   Foreground="{DynamicResource AccentBrush}" Text="本次修改只影响当前日期。" />

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <CheckBox x:Name="PlanDateCheck" Content="开始日期" VerticalAlignment="Center"
                      Checked="PlanDateCheck_Changed" Unchecked="PlanDateCheck_Changed" />
            <DatePicker x:Name="PlanDatePicker" Grid.Column="1" Margin="18,0,0,0" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="TimeCheck" Content="指定时间" VerticalAlignment="Center"
                      Checked="TimeCheck_Changed" Unchecked="TimeCheck_Changed" />
            <TextBox x:Name="StartTimeBox" Grid.Column="1" Margin="16,0,6,0" ToolTip="开始时间，例如 09:30" />
            <TextBlock Grid.Column="2" Text="至" VerticalAlignment="Center" Margin="4,0" />
            <TextBox x:Name="EndTimeBox" Grid.Column="3" Margin="6,0" ToolTip="结束时间，例如 10:00" />
            <TextBlock Grid.Column="4" Text="格式 HH:mm" VerticalAlignment="Center" Margin="8,0,0,0"
                       FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,14,0,0">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <CheckBox x:Name="DueCheck" Content="截止日期" VerticalAlignment="Center"
                      Checked="DueCheck_Changed" Unchecked="DueCheck_Changed" />
            <DatePicker x:Name="DueDatePicker" Grid.Column="1" Margin="18,0,0,0" />
        </Grid>
        <TextBlock Text="设置开始和截止日期后，普通任务将在这段时间每天显示（含首尾）。"
                   TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0" Foreground="{DynamicResource MutedTextBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="重复" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                <ComboBox x:Name="RepeatCombo" Grid.Column="1" SelectionChanged="RepeatCombo_SelectionChanged" Padding="8,6">
                    <ComboBoxItem Content="不重复" Tag="0"/>
                    <ComboBoxItem Content="每天" Tag="1"/>
                    <ComboBoxItem Content="工作日" Tag="2"/>
                    <ComboBoxItem Content="每周指定日期" Tag="3"/>
                </ComboBox>
            </Grid>
            <WrapPanel x:Name="WeekDaysPanel" Visibility="Collapsed" Margin="100,10,0,0">
                <CheckBox x:Name="MondayCheck" Content="一" Tag="1" Margin="0,0,12,0"/>
                <CheckBox x:Name="TuesdayCheck" Content="二" Tag="2" Margin="0,0,12,0"/>
                <CheckBox x:Name="WednesdayCheck" Content="三" Tag="3" Margin="0,0,12,0"/>
                <CheckBox x:Name="ThursdayCheck" Content="四" Tag="4" Margin="0,0,12,0"/>
                <CheckBox x:Name="FridayCheck" Content="五" Tag="5" Margin="0,0,12,0"/>
                <CheckBox x:Name="SaturdayCheck" Content="六" Tag="6" Margin="0,0,12,0"/>
                <CheckBox x:Name="SundayCheck" Content="日" Tag="0"/>
            </WrapPanel>
        </StackPanel>

        <Grid Grid.Row="6" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="状态" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
            <ComboBox x:Name="StatusCombo" Grid.Column="1" Padding="8,6">
                <ComboBoxItem Content="待办"/><ComboBoxItem Content="进行中"/>
                <ComboBoxItem Content="已完成"/><ComboBoxItem Content="已跳过"/>
            </ComboBox>
        </Grid>

        <StackPanel Grid.Row="7" Margin="0,14,0,0">
            <TextBlock Text="备注（可选）" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6" />
            <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     MinHeight="105" />
        </StackPanel>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Click="Cancel_Click" Margin="0,0,8,0" />
            <Button Content="保存" Click="Save_Click" Background="{DynamicResource AccentBrush}"
                    Foreground="White" BorderBrush="{DynamicResource AccentBrush}" Width="90" />
        </StackPanel>
    </Grid>
</Window>
