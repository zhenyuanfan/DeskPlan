<Window x:Class="DeskPlan.TaskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="任务详情" Width="500" Height="650" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style TargetType="DatePickerTextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="任务详情" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18" Foreground="{DynamicResource TextBrush}"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,3,0">
            <StackPanel>
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="要做什么" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8" />
                        <TextBox x:Name="TitleBox" FontSize="17" />
                        <TextBlock x:Name="OccurrenceHint" Visibility="Collapsed" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Text="本次修改只影响当前日期。" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <CheckBox x:Name="PlanDateCheck" Content="开始日期" VerticalAlignment="Center" Checked="PlanDateCheck_Changed" Unchecked="PlanDateCheck_Changed" />
                            <DatePicker x:Name="PlanDatePicker" Grid.Column="1" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <CheckBox x:Name="TimeCheck" Content="指定时间" VerticalAlignment="Center" Checked="TimeCheck_Changed" Unchecked="TimeCheck_Changed" />
                            <TextBox x:Name="StartTimeBox" Grid.Column="1" ToolTip="开始时间，格式 HH:mm，例如 09:30" />
                            <TextBlock Grid.Column="2" Text="—" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBox x:Name="EndTimeBox" Grid.Column="3" ToolTip="结束时间，格式 HH:mm，例如 10:00" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <CheckBox x:Name="DueCheck" Content="截止日期" VerticalAlignment="Center" Checked="DueCheck_Changed" Unchecked="DueCheck_Changed" />
                            <DatePicker x:Name="DueDatePicker" Grid.Column="1" />
                        </Grid>
                        <TextBlock Text="设置开始和截止日期后，普通任务将在这段时间每天显示（含首尾）。" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0" Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="重复" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                            <ComboBox x:Name="RepeatCombo" Grid.Column="1" SelectionChanged="RepeatCombo_SelectionChanged">
                                <ComboBoxItem Content="不重复" Tag="0"/><ComboBoxItem Content="每天" Tag="1"/>
                                <ComboBoxItem Content="工作日（含调休补班）" Tag="2"/><ComboBoxItem Content="每周指定日期" Tag="3"/>
                            </ComboBox>
                        </Grid>
                        <WrapPanel x:Name="WeekDaysPanel" Visibility="Collapsed" Margin="94,10,0,0">
                            <CheckBox x:Name="MondayCheck" Content="一" Tag="1" Margin="0,0,10,6"/>
                            <CheckBox x:Name="TuesdayCheck" Content="二" Tag="2" Margin="0,0,10,6"/>
                            <CheckBox x:Name="WednesdayCheck" Content="三" Tag="3" Margin="0,0,10,6"/>
                            <CheckBox x:Name="ThursdayCheck" Content="四" Tag="4" Margin="0,0,10,6"/>
                            <CheckBox x:Name="FridayCheck" Content="五" Tag="5" Margin="0,0,10,6"/>
                            <CheckBox x:Name="SaturdayCheck" Content="六" Tag="6" Margin="0,0,10,6"/>
                            <CheckBox x:Name="SundayCheck" Content="日" Tag="0" Margin="0,0,0,6"/>
                        </WrapPanel>
                        <TextBlock Text="重复任务自动跳过官方放假日；假期临时安排请选择“不重复”。" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0" Foreground="{DynamicResource MutedTextBrush}" />
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="状态" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                            <ComboBox x:Name="StatusCombo" Grid.Column="1">
                                <ComboBoxItem Content="待办"/><ComboBoxItem Content="进行中"/><ComboBoxItem Content="已完成"/><ComboBoxItem Content="已跳过"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SectionCard}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="备注 · 可选" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8" />
                        <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="88" MaxHeight="160" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Click="Cancel_Click" Margin="0,0,8,0" MinWidth="76" IsCancel="True" />
            <Button Content="保存" Click="Save_Click" Background="{DynamicResource AccentBrush}" Foreground="White" BorderBrush="{DynamicResource AccentBrush}" Width="90" FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</Window>
