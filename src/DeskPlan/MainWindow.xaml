<Window x:Class="DeskPlan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面计划" Width="380" Height="360" MinWidth="370" MinHeight="330"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="Manual"
        Closing="Window_Closing" LocationChanged="Window_LocationChanged">
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <DataTemplate x:Key="DayPreviewTaskTemplate">
            <Border x:Name="PreviewTaskCard" Padding="14" Margin="0,0,0,8" CornerRadius="12"
                    BorderThickness="1" BorderBrush="{DynamicResource SoftBorderBrush}" Background="{DynamicResource HeaderBrush}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock x:Name="PreviewTaskTitle" Text="{Binding Title}" FontSize="15" FontWeight="Medium" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="{Binding SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock Text="{Binding DateRangeText}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsMultiDay}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding StatusText}" Margin="0,5,0,0" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="编辑" Tag="{Binding}" Click="DayPreviewEdit_Click" FontSize="12"
                            Padding="8,6" VerticalAlignment="Top" AutomationProperties.Name="编辑任务" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="PreviewTaskCard" Property="Opacity" Value="0.65" />
                    <Setter TargetName="PreviewTaskTitle" Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="CompactTaskTemplate">
            <Border x:Name="TaskRow" Padding="10,9" Margin="0,0,0,5" CornerRadius="12"
                    BorderThickness="1" BorderBrush="{DynamicResource SoftBorderBrush}" Background="{DynamicResource HeaderBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="DoneButton" Grid.Column="0" Tag="{Binding}" Content="○" ToolTip="完成 / 恢复待办"
                            AutomationProperties.Name="完成或恢复任务" VerticalAlignment="Top"
                            Click="CompleteTask_Click" Width="22" Height="22" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource AccentBrush}" FontSize="20" />
                    <StackPanel Grid.Column="2" Margin="6,0,4,0">
                        <TextBlock x:Name="TaskTitle" Text="{Binding Title}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Medium" />
                        <TextBlock x:Name="TaskDetail" Text="{Binding SecondaryText}" FontSize="11" Margin="0,3,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                    <Button Grid.Column="3" Tag="{Binding}" Content="×" Click="DeleteTask_Click"
                            Padding="0" Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource MutedTextBrush}" ToolTip="删除" AutomationProperties.Name="删除任务" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding SecondaryText}" Value="">
                    <Setter TargetName="TaskDetail" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="TaskRow" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter TargetName="TaskRow" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="InProgress">
                    <Setter TargetName="TaskRow" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="TaskRow" Property="Opacity" Value="0.6" />
                    <Setter TargetName="TaskTitle" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="DoneButton" Property="Content" Value="✓" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{DynamicResource CardBrush}" CornerRadius="22" Margin="4"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.10" Color="#233452" /></Border.Effect>
        <Grid>
            <Grid x:Name="CompactPanel" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="DragArea_MouseLeftButtonDown" ToolTip="拖动这里可移动组件">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ClockText" FontFamily="Segoe UI Variable Display" FontSize="32"
                                   FontWeight="Light" Foreground="{DynamicResource TextBrush}" />
                        <StackPanel Margin="11,2,0,0">
                            <TextBlock x:Name="TodayDateText" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock x:Name="RemainingText" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Content="月历 ↗" Click="Expand_Click"
                            Style="{StaticResource IconButton}" Background="{DynamicResource AccentSoftBrush}"
                            Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Padding="10,7" FontSize="12" />
                </Grid>
                <Grid Grid.Row="1" Margin="5,0">
                    <TextBlock Text="今日待办" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TodayEmptyText" Text="留一点时间给自己" Visibility="Collapsed"
                               HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </Grid>
                <ListBox x:Name="CompactTaskList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                         ItemTemplate="{StaticResource CompactTaskTemplate}"
                         AllowDrop="True" PreviewMouseLeftButtonDown="CompactTaskList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="CompactTaskList_PreviewMouseMove" Drop="CompactTaskList_Drop"
                         MouseDoubleClick="CompactTaskList_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <Grid Grid.Row="3" Margin="0,7,0,0">
                    <TextBox x:Name="CompactAddBox" KeyDown="CompactAddBox_KeyDown"
                             VerticalContentAlignment="Center" Padding="11,5" BorderBrush="{DynamicResource SoftBorderBrush}"
                             AutomationProperties.Name="快速添加今日任务" />
                    <TextBlock Text="＋  记一件今天要做的事…" IsHitTestVisible="False" Margin="12,0"
                               VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource MutedTextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=CompactAddBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>

            <Grid x:Name="ExpandedPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="114" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="32" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" CornerRadius="22,22,0,0"
                        BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                    <Grid Margin="22,14">
                        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="8"/><RowDefinition Height="36"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock x:Name="MonthTitleText" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="‹" Style="{StaticResource IconButton}" Click="PreviousMonth_Click" ToolTip="上个月" AutomationProperties.Name="上个月" />
                                <Button Content="今天" Padding="9,5" Background="Transparent" Click="TodayMonth_Click" />
                                <Button Content="›" Style="{StaticResource IconButton}" Click="NextMonth_Click" ToolTip="下个月" AutomationProperties.Name="下个月" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="SelectedDateText" Grid.Row="2" Grid.ColumnSpan="2" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBox x:Name="MonthAddBox" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Margin="8,0,0,0" KeyDown="MonthAddBox_KeyDown"
                                 VerticalContentAlignment="Center" Background="{DynamicResource CardBrush}"
                                 BorderBrush="{DynamicResource SoftBorderBrush}" AutomationProperties.Name="快速添加所选日期任务" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Text="＋  添加安排，按回车保存…" IsHitTestVisible="False"
                                   Margin="20,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=MonthAddBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ReviewButton" Content="待整理" Click="Review_Click" Margin="3,0" Background="Transparent" />
                            <Button Content="＋ 新建" Style="{StaticResource PrimaryButton}" Click="AddDetailed_Click" Margin="3,0" />
                            <Button Content="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource IconButton}" Click="Settings_Click" ToolTip="设置" AutomationProperties.Name="设置" />
                            <Button Content="收起" Click="Collapse_Click" Margin="3,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="ReviewBanner" Grid.Row="1" Visibility="Collapsed" Margin="14,9,14,0"
                        Background="#1AF79009" BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="10,6">
                    <TextBlock x:Name="ReviewText" Foreground="{DynamicResource TextBrush}" />
                </Border>

                <UniformGrid Grid.Row="2" Columns="7" Margin="12,10,12,0" TextBlock.Foreground="{DynamicResource MutedTextBrush}" TextBlock.FontSize="11">
                    <TextBlock Text="周日" HorizontalAlignment="Center"/><TextBlock Text="周一" HorizontalAlignment="Center"/>
                    <TextBlock Text="周二" HorizontalAlignment="Center"/><TextBlock Text="周三" HorizontalAlignment="Center"/>
                    <TextBlock Text="周四" HorizontalAlignment="Center"/><TextBlock Text="周五" HorizontalAlignment="Center"/>
                    <TextBlock Text="周六" HorizontalAlignment="Center"/>
                </UniformGrid>

                <Grid x:Name="MonthHost" Grid.Row="3" Margin="10,0,10,4" ClipToBounds="True" />

                <Grid Grid.Row="4" Margin="18,0">
                    <TextBlock Text="悬停日期查看完整任务 · 双击日期新建 · 双击任务编辑"
                               VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="CalendarStatusText" HorizontalAlignment="Right" VerticalAlignment="Center"
                               ToolTip="重复任务跳过官方放假日，手动新建的普通任务照常显示。数据仅保存在本机。"
                               FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                </Grid>
                <Canvas x:Name="DayPreviewLayer" Grid.RowSpan="5" Panel.ZIndex="10" Visibility="Collapsed">
                    <Border x:Name="DayPreviewCard" Width="420" MaxHeight="540" Padding="18"
                            CornerRadius="20" Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.16" Color="#233452" /></Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="DayPreviewTitle" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock x:Name="DayPreviewCount" FontSize="12" Margin="0,5,0,0" Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="×" Style="{StaticResource IconButton}" Click="DayPreviewClose_Click"
                                        VerticalAlignment="Top" ToolTip="关闭（Esc）" AutomationProperties.Name="关闭当天详情" />
                            </Grid>
                            <ListBox x:Name="DayPreviewList" Grid.Row="1" ItemTemplate="{StaticResource DayPreviewTaskTemplate}"
                                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False"
                                     HorizontalContentAlignment="Stretch" AutomationProperties.Name="当天完整任务列表" />
                            <TextBlock x:Name="DayPreviewEmpty" Grid.Row="1" Text="这一天还没有安排" Margin="0,24" FontSize="14"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <TextBlock Text="移入卡片可滚动查看" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                                <Button Content="＋ 当天新建" Click="DayPreviewAdd_Click" Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Right" FontSize="12" />
                            </Grid>
                        </Grid>
                    </Border>
                </Canvas>
            </Grid>

            <Border x:Name="UndoBar" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Margin="18" Padding="14,9" CornerRadius="12" Background="#F0202B3D">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="UndoText" Foreground="White" VerticalAlignment="Center" />
                    <Button Content="撤销" Click="Undo_Click" Margin="14,0,0,0" Padding="8,3"
                            Background="Transparent" Foreground="White" BorderBrush="#66FFFFFF" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
